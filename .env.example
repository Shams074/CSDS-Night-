# ==============================================================================
# CSDS Welcome Party & Farewell Night 2026 - Environment Variables
# ==============================================================================

# 1. Supabase Configuration (Get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Admin Portal Allowlist (Comma-separated emails allowed to access /admin)
ADMIN_EMAILS=admin@csds.uop.edu.pk,president.csds@gmail.com

# 3. Transactional Email Service (Resend or SMTP)
# Sign up at https://resend.com to get your API key
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL="CSDS Peshawar <onboarding@resend.dev>"

# 4. Public Site URL (Used for generating absolute asset URLs in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
